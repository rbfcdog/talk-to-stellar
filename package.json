{
  "name": "talk-to-stellar",
  "version": "0.1.0",
  "private": true,
  "description": "Root deploy entrypoint for TalkToStellar services.",
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build",
    "frontend:build": "npm --prefix frontend run build",
    "backend:build": "npm --prefix backend run build",
    "env:generate": "node backend/scripts/generate-env.mjs",
    "instawards:evidence": "node backend/scripts/instawards-evidence.mjs",
    "passkey:env": "node backend/scripts/generate-passkey-env.mjs",
    "passkey:smart-account": "npm --prefix backend run passkey:smart-account --",
    "telegram:start": "npm --prefix telegram start"
  },
  "engines": {
    "node": ">=20"
  }
}
