TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_AGENT_URL=http://localhost:3001/api/agent/query
TELEGRAM_BOT_MODE=webhook
TELEGRAM_BOT_USERNAME=talktostellar_bot
TELEGRAM_HEALTH_PORT=3005
TELEGRAM_SESSION_PREFIX=telegram
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_WEBHOOK_URL=https://your-public-domain.com
TELEGRAM_PROFILE_SETUP=true
# Optional override. Default is telegram/assets/talktostellar-avatar.jpg,
# generated from frontend/public/talktostellar.png for Telegram profile upload.
TELEGRAM_PROFILE_PHOTO_PATH=
TELEGRAM_SHORT_DESCRIPTION=TalkToStellar account assistant for balance, PIX, conversion, yield, and withdrawals.
TELEGRAM_DESCRIPTION=TalkToStellar helps you check your balance, add or withdraw with PIX, convert currencies, keep money earning, manage contacts, and send payments from Telegram.
# Backend payment notifications call POST /notify on this service.
# Use the same value as backend TELEGRAM_NOTIFY_SECRET or INTERNAL_API_SECRET.
TELEGRAM_NOTIFY_SECRET=change-me
# Shared secret sent on every POST to TELEGRAM_AGENT_URL as the
# x-agent-ingest-secret header. Must match the backend resolved ingest value.
# Preferred: AGENT_INGEST_SECRET. Compatibility fallback order:
# AGENT_INGEST_SECRET, INTERNAL_API_SECRET, TELEGRAM_NOTIFY_SECRET.
# Without one of these the bot refuses to start.
AGENT_INGEST_SECRET=change-me
