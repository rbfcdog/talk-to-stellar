# Local Evolution API server for TalkToStellar.
# Replace AUTHENTICATION_API_KEY before exposing this server publicly.

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
EVOLUTION_PUBLIC_URL=http://localhost:8080

AUTHENTICATION_API_KEY=change-me-talktostellar-evolution-local
EVOLUTION_API_KEY=change-me-talktostellar-evolution-local
INSTANCE_NAME=main
INSTANCE_TOKEN=main-local-token
# Optional: bot owner number with country code, e.g. 5511999999999.
OWNER_NUMBER=
# Optional: default test recipient for scripts/send-text.sh.
TEST_SEND_NUMBER=

POSTGRES_DATABASE=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_PORT=5434

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=talktostellar_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

REDIS_PORT=6380
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=talktostellar_evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

STORE_MESSAGES=true
STORE_MESSAGE_UP=true
STORE_CONTACTS=true
STORE_CHATS=true

WEBHOOK_GLOBAL_ENABLED=true
# Important:
# - Browser URL: http://localhost:8080
# - Container -> host backend URL: http://host.docker.internal:3001
# Do not open host.docker.internal in Firefox; that hostname is for Docker containers.
WEBHOOK_GLOBAL_URL=http://host.docker.internal:3001/webhook/evolution
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

CONFIG_SESSION_PHONE_CLIENT=TalkToStellar
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS
LOG_COLOR=true
LOG_BAILEYS=error
TELEMETRY=false
