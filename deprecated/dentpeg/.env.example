# DentPeg API key (required)
# Get yours at https://app.dentpeg.com → sign up → "Desenvolvedores" → create key
DENTPEG_API_KEY=dpx_your_api_key_here

# Server port
PORT=3334

# Payout mode (where you receive tokens after PIX is paid)
# Options: DEPIX, USDT_BSC, USDT_ETH, USDC_BSC, USDC_ETH, USDT_SOLANA, USDC_SOLANA
# DENTPEG_PAYOUT_TYPE=DEPIX
# DENTPEG_PAYOUT_ADDRESS=

# Optional: DentPeg webhook secret (for verifying incoming webhooks)
# DENTPEG_WEBHOOK_SECRET=
