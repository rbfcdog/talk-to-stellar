# BlindPay API credentials (required)
BLINDPAY_API_KEY=your_api_key_here
BLINDPAY_INSTANCE_ID=in_xxxxxxxxxxxx

# Instance type: "development" or "production"
BLINDPAY_INSTANCE_TYPE=development

# Optional overrides
# BLINDPAY_STELLAR_NETWORK=testnet
# BLINDPAY_STELLAR_SECRET=S...
# BLINDPAY_HTTP_PORT=3333
# BLINDPAY_STATE_FILE=./.blindpay-state.json

# KYC document placeholders (for development)
BLINDPAY_SELFIE_FILE=https://picsum.photos/id/237/200/300
BLINDPAY_ID_DOC_FRONT_FILE=https://picsum.photos/id/237/200/300
BLINDPAY_ID_DOC_BACK_FILE=https://picsum.photos/id/237/200/300
