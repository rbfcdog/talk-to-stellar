# Stellar Mainnet preparation only.
# Do not copy this over the active Testnet config yet. The live runtime must
# keep STELLAR_NETWORK=TESTNET until the product cutover is explicitly approved.

# Active runtime remains Testnet.
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Isolated Mainnet infrastructure. These variables are read only by
# npm run stellar:mainnet:readiness and future Mainnet wiring.
STELLAR_MAINNET_ENABLED=false
STELLAR_MAINNET_ALLOW_RUNTIME_ACTIVATION=false
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
STELLAR_MAINNET_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
STELLAR_MAINNET_STELLAR_EXPERT_URL=https://stellar.expert/explorer/public

# Mainnet asset issuers.
STELLAR_MAINNET_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_MAINNET_BRL_ISSUER=GDVKY2GU2DRXWTBEYJJWSFXIGBZV6AZNBVVSUHEPZI54LIS6BA7DVVSP
STELLAR_MAINNET_TESOURO_ISSUER=GC3CW7EDYRTWQ635VDIGY6S4ZUF5L6TQ7AA4MWS7LEQDBLUSZXV7UPS4

# Operational accounts. Use public keys only here.
STELLAR_MAINNET_FEE_TREASURY_PUBLIC_KEY=
STELLAR_MAINNET_DISTRIBUTION_PUBLIC_KEY=

# Signing mode. Prefer external or kms for Mainnet. Avoid raw private keys in env.
# Allowed values: disabled, external, kms, vault.
STELLAR_MAINNET_SIGNER_MODE=disabled
STELLAR_MAINNET_EXTERNAL_SIGNER_URL=
STELLAR_MAINNET_KMS_KEY_ID=
STELLAR_MAINNET_VAULT_SECRET_ID=

# Blast-radius controls for initial cutover.
STELLAR_MAINNET_REQUIRE_MANUAL_APPROVAL=true
STELLAR_MAINNET_MAX_PAYMENT_USDC=
STELLAR_MAINNET_ALLOW_BULK_MUTATION=false

# Optional SEP/anchor identity, needed before public anchor/auth flows.
STELLAR_MAINNET_SEP10_HOME_DOMAIN=
STELLAR_MAINNET_STELLAR_TOML_URL=
