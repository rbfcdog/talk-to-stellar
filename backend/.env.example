# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Supabase Configuration  
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# PIN hashing
# Required in production for new per-PIN random-salt hashes. Keep this server-side only.
PIN_PEPPER=replace-with-a-long-random-secret

# OpenAI Configuration (Required for Agent LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here


# Stellar Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_FRIENDBOT_TIMEOUT_MS=5000
STELLAR_SECRET_KEY=
STELLAR_PUBLIC_KEY=
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=
# BRL issuer strategy:
# - PUBLIC network default: nTokens BRL issuer (if BRL_ISSUER_PUBLIC is not set)
# - TESTNET network: set BRL_ISSUER_TESTNET explicitly (for dynamic/local issuer)
BRL_ISSUER_PUBLIC=GDVKY2GU2DRXWTBEYJJWSFXIGBZV6AZNBVVSUHEPZI54LIS6BA7DVVSP
BRL_ISSUER_TESTNET=
BRL_ISSUER_SECRET=
BRL_DISTRIBUTOR_PUBLIC=
BRL_DISTRIBUTOR_SECRET=
BRL_MARKET_MAKER_PUBLIC=
BRL_MARKET_MAKER_SECRET=
TESTNET_SETUP_BRL_ISSUANCE_AMOUNT=100000
TESTNET_SETUP_BRL_LIQUIDITY_AMOUNT=20000
TESTNET_SETUP_USDC_BRL_LIQUIDITY_AMOUNT=2000
TESTNET_SETUP_USE_DYNAMIC_RATES=true
# Optional manual fallback only if TESTNET_SETUP_USE_DYNAMIC_RATES=false
# TESTNET_SETUP_BRL_PER_XLM_PRICE=
# TESTNET_SETUP_BRL_PER_USDC_PRICE=

# BRL/USDC market quote tool
BRL_USDC_QUOTE_SOURCE=binance
BRL_USDC_QUOTE_SYMBOL=USDCBRL
BRL_USDC_QUOTE_TIMEOUT_MS=8000

# API / Internal Auth
PORT=3001
INTERNAL_API_SECRET=change-me
# Shared secret the Telegram/WhatsApp bots must present (header
# x-agent-ingest-secret) when posting to /api/agent/query. Prefer setting this
# explicitly. For older deployments the backend also accepts INTERNAL_API_SECRET
# or TELEGRAM_NOTIFY_SECRET as compatibility fallbacks, but every channel must
# use the same resolved value.
AGENT_INGEST_SECRET=change-me

# Email confirmation delivery is intentionally disabled in the backend.

# Telegram notifications after browser-based payment confirmations.
# Prefer TELEGRAM_NOTIFY_URL when the Telegram adapter is deployed separately.
# The adapter exposes POST /notify and validates TELEGRAM_NOTIFY_SECRET or INTERNAL_API_SECRET.
TELEGRAM_NOTIFY_URL=http://localhost:3005/notify
TELEGRAM_NOTIFY_SECRET=change-me
# Optional direct fallback if the backend should call Telegram Bot API itself.
TELEGRAM_BOT_TOKEN=

# Evolution API WhatsApp test webhook
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
PUBLIC_BACKEND_URL=https://your-backend.example.com
EVOLUTION_WEBHOOK_SECRET=
# Optional. Defaults to the local backend /api/agent/query endpoint.
EVOLUTION_AGENT_URL=http://127.0.0.1:3001/api/agent/query
EVOLUTION_AGENT_TIMEOUT_MS=120000
EVOLUTION_CONTENT_DEDUPE_TTL_MS=90000
EVOLUTION_SEND_FAILURE_FALLBACK=false

# Frontend onboarding URL base
CREATE_ACCOUNT_BASE=http://localhost:3000
# Frontend payment confirmation URL base (if omitted, falls back to CREATE_ACCOUNT_BASE)
PAYMENT_CONFIRM_BASE=http://localhost:3000
# Optional fallback if CREATE_ACCOUNT_BASE is not set
FRONTEND_URL=http://localhost:3000
# Optional generic public app URL fallback
PUBLIC_APP_URL=http://localhost:3000

# Passkey / WebAuthn
# In production these must match the HTTPS frontend domain that opens the passkey prompt.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
PASSKEY_RP_NAME=TalkToStellar
PASSKEY_OPERATION_TIMEOUT_MS=180000
PASSKEY_USER_VERIFICATION=preferred

# Dynamic conversion / onboarding behavior
ONBOARDING_AUTO_CONVERT_TO_USDC=true
# Confirmation quotes expire quickly to avoid stale conversion rates and slippage.
QUOTE_TTL_SECONDS=30
# Platform spread used in path payments/conversions.
# Set treasury public key to enable collection; if omitted, spread is disabled.
# Default product fee is 0.30%, deducted from the user's source amount and sent to treasury.
TALKTOSTELLAR_SPREAD_BPS=30
TALKTOSTELLAR_FEE_TREASURY_PUBLIC_KEY=
TALKTOSTELLAR_SPREAD_MIN_USDC=0.01
TALKTOSTELLAR_SPREAD_MIN_BRL=0.05
# Savings comparison baseline, used only for transparent estimates.
TRADITIONAL_FEE_PCT=0.045
DEFAULT_USD_BRL_RATE=
# Safety guard for PIX USD receive estimates. Market data is used first.
# Static env fallback is disabled unless ALLOW_USD_BRL_ENV_FALLBACK=true.
ALLOW_USD_BRL_ENV_FALLBACK=false
USD_BRL_SANITY_MIN=3
USD_BRL_SANITY_MAX=10
# Keep only the minimum spendable reserve after Friendbot funding; sweep the rest to USDC.
ONBOARDING_KEEP_XLM=1.5
ENABLE_BRL_ASSET=true
STELLAR_ENFORCE_TRUSTED_PATH_ASSETS=false

# Etherfuse sandbox PIX/TESOURO ramp
# Keep this server-side only. Do not expose it through NEXT_PUBLIC_*.
ETHERFUSE_API_KEY=api_sand:your-api-key:your-organization-id
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com
ETHERFUSE_BLOCKCHAIN=stellar
ETHERFUSE_WEBHOOK_SECRET=
ENABLE_TESOURO_ASSET=true
TESOURO_ISSUER=GC3CW7EDYRTWQ635VDIGY6S4ZUF5L6TQ7AA4MWS7LEQDBLUSZXV7UPS4

# BRL -> USDC -> USD international account delivery
PAYOUT_PROVIDER=mock
CIRCLE_API_KEY=
CIRCLE_PAYOUT_CREATE_URL=
BRIDGE_API_KEY=
BRIDGE_PAYOUT_CREATE_URL=
ENABLE_REAL_PAYOUT_EXECUTION=false
ENABLE_MAINNET_SETTLEMENT_VALIDATION=false
MAX_MAINNET_VALIDATION_AMOUNT_USD=25
USD_OFFRAMP_STELLAR_DESTINATION=
PAYOUT_STELLAR_DESTINATION_PUBLIC_KEY=
BRL_USD_QUOTE_TTL_SECONDS=300
MOCK_USD_PAYOUT_AUTO_COMPLETE=false
INTERNATIONAL_TRANSFER_ENABLE_MOCK_PIX=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# In-process API rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
SENSITIVE_RATE_LIMIT_MAX=30

# Daily automatic summary
ENABLE_DAILY_SUMMARY=true
DAILY_SUMMARY_TIMEZONE=America/Sao_Paulo
DAILY_SUMMARY_HOUR_LOCAL=9
DAILY_SUMMARY_INTERVAL_MS=900000
DAILY_SUMMARY_STARTUP_DELAY_MS=20000
