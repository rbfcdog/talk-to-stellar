{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API para projeto Meridian com Stellar SDK",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:wallet": "jest wallet.test.ts",
    "test:api": "jest api-integration.test.ts",
    "test:stellar": "jest stellar-sdk.test.ts",
    "test:agent": "jest agent-ai.test.ts",
    "test:yield": "jest --runInBand tests/defindex-yield.service.test.ts tests/defindex-yield-transactions.test.ts",
    "eval:agent": "jest --runInBand tests/agent-production-eval.test.ts tests/agent-conversion-ux.test.ts tests/agent-pix-offramp.test.ts tests/agent-payment-link.test.ts tests/agent-tools.test.ts",
    "test:e2e": "jest e2e.test.ts",
    "test:ci": "jest --coverage --bail --forceExit",
    "seed:users": "ts-node scripts/seed-users.ts --count",
    "stellar:first-tx": "ts-node scripts/first-testnet-transaction.ts",
    "stellar:setup-xlm-usdc-liquidity": "ts-node scripts/setup-xlm-usdc-liquidity.ts",
    "stellar:debug-path-quotes": "ts-node scripts/debug-path-quotes.ts",
    "stellar:mainnet:readiness": "ts-node scripts/stellar-mainnet-readiness.ts",
    "stellar:mainnet:readiness:strict": "ts-node scripts/stellar-mainnet-readiness.ts --strict",
    "stellar:mainnet:audit": "ts-node scripts/stellar-mainnet-audit.ts",
    "stellar:mainnet:audit:strict": "ts-node scripts/stellar-mainnet-audit.ts --strict",
    "stellar:backfill-default-trustlines": "ts-node scripts/backfill-default-trustlines.ts",
    "stellar:backfill-all-wallets-trustlines": "ts-node scripts/backfill-trustlines-all-existing-wallets.ts",
    "financial:backfill-global-profiles": "ts-node scripts/backfill-global-profiles.ts",
    "financial:send-daily-summaries-once": "ts-node scripts/send-daily-summaries-once.ts",
    "etherfuse:measure-fees": "ts-node scripts/measure-etherfuse-testnet-fees.ts",
    "etherfuse:preview-pix-onramp-fees": "ts-node scripts/preview-pix-onramp-fees.ts",
    "defindex:env": "ts-node scripts/setup-defindex-env.ts",
    "passkey:smart-account": "ts-node scripts/setup-passkey-smart-account.ts",
    "evolution:configure-webhook": "ts-node scripts/configure-evolution-webhook.ts",
    "migrate:financial-assistant": "ts-node scripts/run-financial-assistant-migration.ts",
    "migrate:required": "ts-node scripts/run-required-migrations.ts"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@defindex/sdk": "^0.3.0",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.2.5",
    "@langchain/openai": "^1.4.5",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/server": "^13.3.0",
    "@stellar/stellar-sdk": "^14.1.1",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.2.37",
    "stellar-base": "^13.1.0",
    "toml": "^3.0.0",
    "uuid": "^9.0.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.14",
    "@types/uuid": "^9.0.7",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "supabase": "^2.40.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
