# ─── Twilio Credentials ───────────────────────────────────────────────────────
# console.twilio.com → clique no nome da conta (canto superior esquerdo)
# "Account Info" → copie os dois valores abaixo

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Seu número WhatsApp no Twilio ────────────────────────────────────────────
# Messaging → Senders → WhatsApp Senders → copie o número
# OBRIGATÓRIO manter o prefixo "whatsapp:"

TWILIO_WHATSAPP_NUMBER=whatsapp:+55XXXXXXXXXXX

# ─── Porta do servidor ────────────────────────────────────────────────────────
PORT=3000
